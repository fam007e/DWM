#!/bin/bash
# ─────────────────────────────────────────────────────────
# dwm-controlcenter — Rofi-based Control Center for dwm
# Launch with SUPER+F1 or run directly from a terminal.
# Provides: system health checks, quick actions, keybind
# viewer, appearance settings, and system info.
# ─────────────────────────────────────────────────────────
set -euo pipefail

# ── Paths ────────────────────────────────────────────────
# Prefer installed location, fall back to repo checkout
if [ -d "$HOME/.config/rofi/themes" ]; then
    THEME_DIR="$HOME/.config/rofi/themes"
elif [ -d "$HOME/.local/share/dwm/config/rofi/themes" ]; then
    THEME_DIR="$HOME/.local/share/dwm/config/rofi/themes"
else
    THEME_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../config/rofi/themes" 2>/dev/null && pwd)" || THEME_DIR=""
fi

THEME_FILE="${THEME_DIR:+$THEME_DIR/controlcenter.rasi}"

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF")"
DWM_DIR="$HOME/.local/share/dwm"

# Directory holding install.sh / scripts/check-deps.sh: installed data dir first,
# then the checkout this script lives in. Empty if neither has them.
find_repo_dir() {
    local candidate
    for candidate in "$DWM_DIR" "$(dirname "$SELF_DIR")"; do
        if [ -f "$candidate/install.sh" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}
QUICKSHELL_DIR="$HOME/.config/quickshell"
ROFI_DIR="$HOME/.config/rofi"
BG_DIR="$HOME/Pictures/Wallpapers"

# ── Terminal detection ───────────────────────────────────
detect_terminal() {
    for t in alacritty ghostty st xterm; do
        if command -v "$t" &>/dev/null; then
            echo "$t"
            return
        fi
    done
    echo "xterm"
}

TERM_CMD="$(detect_terminal)"

spawn_terminal() {
    case "$TERM_CMD" in
        ghostty)    ghostty -e "$@" &  ;;
        alacritty)  alacritty -e "$@" & ;;
        *)          "$TERM_CMD" -e "$@" & ;;
    esac
}

# Run a script from the repo/data dir in a terminal and keep it open afterwards.
run_repo_script() {
    local script="$1" dir
    if ! dir="$(find_repo_dir)"; then
        notify "Cannot find $script (no DWM checkout or ~/.local/share/dwm/install.sh)" --urgency=critical
        return 0
    fi
    spawn_terminal bash -c 'cd "$1" && bash "$2"; echo; echo "Press Enter to close"; read -r' _ "$dir" "$script"
}

# Restart a background process and wait for the old one to exit before relaunching.
restart_process() {
    local name="$1"; shift
    pkill -x "$name" 2>/dev/null || true
    local i
    for i in $(seq 1 30); do
        pgrep -x "$name" &>/dev/null || break
        sleep 0.1
    done
    setsid "$@" </dev/null >/dev/null 2>&1 &
}

# Pick a random wallpaper, apply it, and refresh the dynamic palette.
set_random_wallpaper() {
    if [ ! -d "$BG_DIR" ]; then
        notify "No wallpaper directory: $BG_DIR" --urgency=critical
        return 1
    fi
    local pick
    pick="$(find -L "$BG_DIR" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) 2>/dev/null | shuf -n1)"
    if [ -z "$pick" ]; then
        notify "No images in $BG_DIR" --urgency=critical
        return 1
    fi
    if ! feh --no-fehbg --bg-fill "$pick"; then
        notify "Failed to set wallpaper" --urgency=critical
        return 1
    fi
    # Keep ~/.fehbg in sync for System Info and session restore
    printf "#!/bin/sh\nfeh --no-fehbg --bg-fill '%s'\n" "$pick" > "$HOME/.fehbg" && chmod +x "$HOME/.fehbg"
    local palette
    palette="$(command -v dwm-wallpaper-palette dwm-wallpaper-palette.py 2>/dev/null | head -1)"
    [ -z "$palette" ] && [ -f "$DWM_DIR/scripts/dwm-wallpaper-palette.py" ] && palette="$DWM_DIR/scripts/dwm-wallpaper-palette.py"
    [ -n "$palette" ] && python3 "$palette" "$pick" >/dev/null 2>&1 || true
    notify "Wallpaper: ${pick##*/}"
}

# ── Rofi helpers ─────────────────────────────────────────
rofi_menu() {
    local prompt="$1" mesg="${2:-}"
    shift 2
    local args=(-dmenu -i -p "$prompt" -theme "$THEME_FILE" -kb-row-left "" -kb-move-char-back "" -kb-custom-1 "Left")
    [ -n "$mesg" ] && args+=(-mesg "$mesg")
    local ret=0
    rofi "${args[@]}" "$@" || ret=$?
    # ret 0 = selected, 1 = escape, 10 = custom-1 (left arrow)
    if [ "$ret" -eq 10 ] || [ "$ret" -eq 1 ]; then
        return 1
    fi
    return 0
}

notify() {
    if command -v notify-send &>/dev/null; then
        notify-send -a "DWM Control Center" "$@" 2>/dev/null || true
    fi
}

# ═════════════════════════════════════════════════════════
# HEALTH CHECK MODULE
# ═════════════════════════════════════════════════════════

run_health_check() {
    local pass=0 fail=0 passed_lines=() failed_lines=()

    # -- helper: check if a command exists --
    _cmd() {
        if command -v "$1" &>/dev/null; then
            passed_lines+=("✓  $1")
            pass=$((pass + 1))
        else
            failed_lines+=("<span color='#bf616a'>✗  $1  (missing)</span>")
            fail=$((fail + 1))
        fi
    }

    # -- helper: check if a package is installed --
    _pkg() {
        if pacman -Qi "$1" &>/dev/null; then
            passed_lines+=("✓  $1")
            pass=$((pass + 1))
        else
            failed_lines+=("<span color='#bf616a'>✗  $1  (not installed)</span>")
            fail=$((fail + 1))
        fi
    }

    # -- helper: check if a font is present --
    _font() {
        local result
        result=$(fc-list : family 2>/dev/null || true)
        local lower="${result,,}"
        local query="${1,,}"
        if [[ "$lower" == *"$query"* ]]; then
            passed_lines+=("✓  $1")
            pass=$((pass + 1))
        else
            failed_lines+=("<span color='#bf616a'>✗  $1  (not found)</span>")
            fail=$((fail + 1))
        fi
    }

    # -- helper: check if a process is running --
    _proc() {
        if pgrep -x "$1" &>/dev/null; then
            passed_lines+=("✓  $1  (running)")
            pass=$((pass + 1))
        else
            failed_lines+=("<span color='#bf616a'>✗  $1  (not running)</span>")
            fail=$((fail + 1))
        fi
    }

    # -- helper: check if a file/dir exists --
    _path() {
        if [ -e "$1" ]; then
            passed_lines+=("✓  $1")
            pass=$((pass + 1))
        else
            failed_lines+=("<span color='#bf616a'>✗  $1  (missing)</span>")
            fail=$((fail + 1))
        fi
    }

    # ── Build dependencies ───────────────────────────────
    _cmd cc
    _cmd make
    for p in libx11 libxft libxinerama imlib2 libxcb freetype2 fontconfig; do
        _pkg "$p"
    done

    # ── Xorg / Xlibre ─────────────────────────────────────
    # Detect Xlibre by any installed xlibre-* package (server, drivers, etc.)
    if pacman -Qq 2>/dev/null | grep -q '^xlibre'; then
        local xlibre_pkg
        xlibre_pkg=$(pacman -Qq 2>/dev/null | grep '^xlibre' | head -1)
        passed_lines+=("✓  Xlibre detected ($xlibre_pkg)")
        pass=$((pass + 1))
    elif pacman -Qi xorg-server &>/dev/null; then
        passed_lines+=("✓  xorg-server")
        pass=$((pass + 1))
    else
        failed_lines+=("<span color='#bf616a'>✗  xorg-server or xlibre  (not installed)</span>")
        fail=$((fail + 1))
    fi
    for p in xorg-xinit xorg-xrandr xorg-xset xorg-xsetroot; do
        _pkg "$p"
    done

    # ── Core Runtime ─────────────────────────────────────
    _cmd rofi
    _cmd picom
    _cmd dunst
    _cmd feh
    _cmd flameshot
    _cmd dex
    _cmd amixer
    _cmd quickshell

    # ── Terminal Emulators ───────────────────────────────
    local term_ok=0
    for t in alacritty ghostty st; do
        if command -v "$t" &>/dev/null; then
            passed_lines+=("✓  $t")
            pass=$((pass + 1)); term_ok=$((term_ok + 1))
        fi
    done
    if [ "$term_ok" -eq 0 ]; then
        failed_lines+=("<span color='#bf616a'>✗  No supported terminal found</span>")
        fail=$((fail + 1))
    fi

    # ── Fonts ────────────────────────────────────────────
    _font "MesloLGS Nerd"
    _font "Noto Color Emoji"

    # ── Running Services ─────────────────────────────────
    _proc picom
    _proc dunst
    _proc quickshell
    if systemctl is-active --quiet NetworkManager 2>/dev/null; then
        passed_lines+=("✓  NetworkManager  (active)")
        pass=$((pass + 1))
    else
        failed_lines+=("<span color='#bf616a'>✗  NetworkManager  (inactive)</span>")
        fail=$((fail + 1))
    fi

    # ── Session & Config Files ───────────────────────────
    _path /usr/share/xsessions/dwm.desktop
    _path "$HOME/.xinitrc"
    _path "$QUICKSHELL_DIR"
    _path "$ROFI_DIR"
    _path "$BG_DIR"

    # ── Display results (failed first, then passed) ──────
    local total=$((pass + fail))
    local summary="$pass/$total checks passed"
    [ "$fail" -gt 0 ] && summary="$summary  ·  <span color='#bf616a'>$fail issues found</span>"

    local all_lines=()
    if [ "${#failed_lines[@]}" -gt 0 ]; then
        all_lines+=("─── Failed ───")
        all_lines+=("${failed_lines[@]}")
    fi
    if [ "${#passed_lines[@]}" -gt 0 ]; then
        all_lines+=("─── Passed ───")
        all_lines+=("${passed_lines[@]}")
    fi

    while true; do
        local chosen
        chosen=$(printf '%s\n' "${all_lines[@]}" | rofi_menu "  System Health" "$summary" -no-custom -markup-rows) || break

        # If user selected a failing item, offer to run install.sh
        if [[ "$chosen" == *"✗"* ]]; then
            local action
            action=$(printf '%s\n' "Run install.sh (auto-fix)" "Run check-deps.sh (details)" \
                | rofi_menu "  Fix" "Selected: $chosen") || continue
            case "$action" in
                "Run install.sh"*)  run_repo_script install.sh ;;
                "Run check-deps"*)  run_repo_script scripts/check-deps.sh ;;
            esac
        fi
    done
}

# ═════════════════════════════════════════════════════════
# QUICK ACTIONS MODULE
# ═════════════════════════════════════════════════════════

run_quick_actions() {
    local items=(
        "  Restart Picom"
        "  Restart Dunst"
        "  Restart Quickshell"
        "  Reload Wallpaper"
        "  Toggle Compositor"
        "  Restart NetworkManager"
        "  Run Dependency Check"
        "  Install Missing Deps"
    )

    while true; do
    local chosen
    chosen=$(printf '%s\n' "${items[@]}" | rofi_menu "  Quick Actions" "Esc / ← to go back") || break

    case "$chosen" in
        *"Restart Picom"*)
            restart_process picom picom -b
            notify "Picom restarted"
            ;;
        *"Restart Dunst"*)
            restart_process dunst dunst
            notify "Dunst restarted"
            ;;
        *"Restart Quickshell"*)
            restart_process quickshell quickshell --path "$QUICKSHELL_DIR/shell.qml" --no-duplicate
            notify "Quickshell restarted"
            ;;
        *"Reload Wallpaper"*)
            set_random_wallpaper || true
            ;;
        *"Toggle Compositor"*)
            if pgrep -x picom &>/dev/null; then
                pkill -x picom 2>/dev/null || true
                notify "Compositor stopped"
            else
                setsid picom -b </dev/null >/dev/null 2>&1 &
                notify "Compositor started"
            fi
            ;;
        *"Restart NetworkManager"*)
            spawn_terminal bash -c "sudo systemctl restart NetworkManager && echo 'NetworkManager restarted'; sleep 2"
            ;;
        *"Run Dependency Check"*)
            run_repo_script scripts/check-deps.sh
            ;;
        *"Install Missing Deps"*)
            run_repo_script install.sh
            ;;
        *) ;;
    esac
    done
}

# ═════════════════════════════════════════════════════════
# THEME SELECT MODULE
# ═════════════════════════════════════════════════════════

run_theme_select() {
    local themes_file="$HOME/.config/dwm/themes.toml"
    if [ ! -f "$themes_file" ]; then
        if [ -f "$HOME/.local/share/dwm/config/themes.toml" ]; then
            mkdir -p "$HOME/.config/dwm"
            cp "$HOME/.local/share/dwm/config/themes.toml" "$themes_file"
        fi
    fi

    if [ ! -f "$themes_file" ]; then
        notify "themes.toml not found" --urgency=critical
        return
    fi

    # Read available theme names from [theme.xxx] headers
    local themes=()
    while IFS= read -r line; do
        if [[ "$line" =~ ^\[theme\.([a-zA-Z0-9_-]+)\] ]]; then
            themes+=("${BASH_REMATCH[1]}")
        fi
    done < "$themes_file"

    if [ "${#themes[@]}" -eq 0 ]; then
        notify "No themes found in themes.toml" --urgency=critical
        return
    fi

    # Get current active theme
    local current
    current=$(awk '/^\[active\]/{found=1} found && /^theme[[:space:]]*=/{split($0,a,"\""); print a[2]; exit}' "$themes_file")

    # Build display list (mark active theme)
    local display=()
    for t in "${themes[@]}"; do
        if [ "$t" = "$current" ]; then
            display+=("  $t  (active)")
        else
            display+=("  $t")
        fi
    done

    local chosen
    chosen=$(printf '%s\n' "${display[@]}" | rofi_menu "  Select Theme" "Current: $current · Esc / ← to go back") || return

    # Extract theme name (strip icon prefix and status suffix)
    local selected
    selected=$(echo "$chosen" | sed 's/^[[:space:]]*//' | awk '{print $1}')

    [ "$selected" = "$current" ] && return

    # Update theme = "..." under [active] in place
    local real_file tmp
    real_file="$(readlink -f "$themes_file")"
    tmp="$(mktemp "$(dirname "$real_file")/.themes.toml.XXXXXX")"
    (
        flock 9
        awk -v new="$selected" '
            /^\[active\]/{found=1}
            found && /^theme[[:space:]]*=/{sub(/"[^"]*"/, "\"" new "\""); found=0}
            {print}
        ' "$real_file" > "$tmp"
        chmod --reference="$real_file" "$tmp"
        mv "$tmp" "$real_file"
    ) 9>"$(dirname "$real_file")/.themes.toml.lock"

    pkill -USR1 -x -u "$(id -u)" dwm 2>/dev/null || true
    notify "Theme: $selected" "Applied"
}

# ═════════════════════════════════════════════════════════
# APPEARANCE MODULE
# ═════════════════════════════════════════════════════════

run_appearance() {
    local items=(
        "  Select Theme"
        "  Randomize Wallpaper"
        "  Open Wallpaper Folder"
        "  GTK Theme Settings"
    )

    while true; do
    local chosen
    chosen=$(printf '%s\n' "${items[@]}" | rofi_menu "  Appearance" "Esc / ← to go back") || break

    case "$chosen" in
        *"Select Theme"*)
            run_theme_select
            ;;
        *"Randomize Wallpaper"*)
            set_random_wallpaper || true
            ;;
        *"Open Wallpaper Folder"*)
            xdg-open "$BG_DIR" 2>/dev/null &
            disown
            ;;
        *"GTK Theme Settings"*)
            if command -v nwg-look &>/dev/null; then
                setsid nwg-look </dev/null >/dev/null 2>&1 &
            else
                notify "nwg-look is not installed" --urgency=critical
            fi
            ;;
    esac
    done
}

# ═════════════════════════════════════════════════════════
# SYSTEM INFO MODULE
# ═════════════════════════════════════════════════════════

run_system_info() {
    local info_lines=()

    # DWM version
    local dwm_ver
    # dwm -v exits non-zero by design; do not let pipefail discard its output
    dwm_ver=$(dwm -v 2>&1 | head -1 || true)
    [ -n "$dwm_ver" ] || dwm_ver="dwm (version unknown)"
    info_lines+=("DWM:  $dwm_ver")

    # Kernel
    info_lines+=("Kernel:  $(uname -sr)")

    # Hostname
    info_lines+=("Host:  $(hostname)")

    # Uptime
    info_lines+=("Uptime:  $(uptime -p 2>/dev/null | sed 's/up //')")

    # Terminal
    info_lines+=("Terminal:  $TERM_CMD")

    # Compositor
    if pgrep -x picom &>/dev/null; then
        info_lines+=("Compositor:  picom (active)")
    else
        info_lines+=("Compositor:  none")
    fi

    # Audio server
    if pgrep -x pipewire &>/dev/null; then
        info_lines+=("Audio:  PipeWire")
    elif pgrep -x pulseaudio &>/dev/null; then
        info_lines+=("Audio:  PulseAudio")
    else
        info_lines+=("Audio:  unknown")
    fi

    # Current wallpaper
    if [ -f "$HOME/.fehbg" ]; then
        local wp
        wp=$(command grep -oP "(?<=').*(?=')" "$HOME/.fehbg" 2>/dev/null | tail -1) || wp="unknown"
        info_lines+=("Wallpaper:  ${wp##*/}")
    fi

    # Display
    if command -v xrandr &>/dev/null; then
        local monitors
        monitors=$(xrandr --query 2>/dev/null | command grep -c " connected") || monitors=0
        info_lines+=("Monitors:  $monitors")
    fi

    printf '%s\n' "${info_lines[@]}" | rofi_menu "  System Info" "Esc / ← to go back" -no-custom || true
}

# ═════════════════════════════════════════════════════════
# MAIN MENU
# ═════════════════════════════════════════════════════════

main_menu() {
    local items=(
        "  System Health"
        "  Quick Actions"
        "  Keybindings"
        "  Appearance"
        "  System Info"
    )

    while true; do
        local chosen
        chosen=$(printf '%s\n' "${items[@]}" | rofi_menu "  DWM Control Center" "dwm · SUPER+F1") || break

        case "$chosen" in
            *"System Health"*)  run_health_check   ;;
            *"Quick Actions"*)  run_quick_actions   ;;
            *"Keybindings"*)
                if command -v dwm-keybinds &>/dev/null; then
                    dwm-keybinds
                else
                    # Try repo-local copy
                    local kb
                    kb="$SELF_DIR/dwm-keybinds"
                    if [ -x "$kb" ]; then
                        "$kb"
                    else
                        notify "dwm-keybinds not found" --urgency=critical
                    fi
                fi
                ;;
            *"Appearance"*)     run_appearance      ;;
            *"System Info"*)    run_system_info     ;;
            *)                  break               ;;
        esac
    done
}

# ── Preflight: make sure rofi and theme exist ────────────
if ! command -v rofi &>/dev/null; then
    echo "Error: rofi is not installed." >&2
    exit 1
fi

if [ ! -f "$THEME_FILE" ]; then
    # Fall back to running without a custom theme
    THEME_FILE=""
    rofi_menu() {
        local prompt="$1" mesg="${2:-}"
        shift 2
        local args=(-dmenu -i -p "$prompt" -kb-row-left "" -kb-move-char-back "" -kb-custom-1 "Left")
        [ -n "$mesg" ] && args+=(-mesg "$mesg")
        local ret=0
        rofi "${args[@]}" "$@" || ret=$?
        if [ "$ret" -eq 10 ] || [ "$ret" -eq 1 ]; then
            return 1
        fi
        return 0
    }
fi

main_menu
