#!/usr/bin/env python3
"""
dwm-calendar - khal interface helper for the DWM Quickshell calendar.

Actions:
  events [MONTH YEAR]   print the month's events as a JSON array
  interactive           open `khal interactive` in dwm-terminal

Every record carries startDay/endDay (days since epoch, inclusive range) so
the UI can mark occupied days without re-parsing locale date strings.

Notes:
  - khal prints multi-day events once per day they cover; those repeats are
    collapsed here, while every occurrence of a recurring series is kept.
  - An explicit --json field subset is requested instead of "all": feed
    calendars carry huge descriptions, so this shrinks the payload ~6x.
"""
import calendar as _calendar
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import date, datetime

EPOCH = date(1970, 1, 1)

# Only fields the calendar UI actually renders.
JSON_FIELDS = (
    "uid", "title", "calendar", "start-date", "start-time",
    "end-date", "end-time", "all-day", "location",
)

_date_fmt = None


def get_khal_date_format():
    """Detect configured khal date format, default to %d/%m/%Y."""
    global _date_fmt
    if _date_fmt:
        return _date_fmt
    fmt = "%d/%m/%Y"
    for name in ("khal.conf", "config"):
        cfg_path = os.path.expanduser("~/.config/khal/" + name)
        if not os.path.exists(cfg_path):
            continue
        try:
            with open(cfg_path, "r", encoding="utf-8") as f:
                in_locale = False
                for line in f:
                    stripped = line.strip()
                    if stripped.startswith("["):
                        in_locale = stripped == "[locale]"
                        continue
                    if in_locale and stripped.startswith("dateformat ") and "=" in stripped:
                        val = stripped.split("=", 1)[1].strip()
                        if val:
                            fmt = val
        except Exception:
            pass
        break
    _date_fmt = fmt
    return fmt


def epoch_day(locale_date):
    """Parse a khal locale date string into days since epoch (None if unknown)."""
    try:
        return (datetime.strptime(locale_date, get_khal_date_format()).date() - EPOCH).days
    except ValueError:
        return None


def make_record(row):
    start_date = row.get("start-date", "")
    end_date = row.get("end-date", "") or start_date
    return {
        "uid": row.get("uid", ""),
        "title": row.get("title") or "Untitled",
        "calendar": row.get("calendar", ""),
        "startDate": start_date,
        "startTime": row.get("start-time", ""),
        "endDate": end_date,
        "endTime": row.get("end-time", ""),
        "allDay": str(row.get("all-day", "False")).lower() == "true",
        "location": row.get("location", ""),
        "startDay": epoch_day(start_date),
        "endDay": epoch_day(end_date),
    }


def fetch_events(month=None, year=None):
    now = datetime.now()
    try:
        m = int(month) if month else now.month
        y = int(year) if year else now.year
    except (ValueError, TypeError):
        m, y = now.month, now.year
    m = min(max(m, 1), 12)
    y = min(max(y, 1), 9999)

    _, last_day = _calendar.monthrange(y, m)
    cmd = ["khal", "list",
           datetime(y, m, 1).strftime(get_khal_date_format()),
           datetime(y, m, last_day).strftime(get_khal_date_format())]
    for field in JSON_FIELDS:
        cmd += ["--json", field]

    events = []
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        for line in proc.stdout.splitlines():
            line = line.strip()
            if not (line.startswith("[") and line.endswith("]")):
                continue
            try:
                for row in json.loads(line):
                    events.append(make_record(row))
            except ValueError:
                pass
    except Exception:
        pass

    seen = set()
    unique = []
    for ev in events:
        key = (ev["uid"], ev["startDate"], ev["startTime"])
        if key in seen:
            continue
        seen.add(key)
        unique.append(ev)

    print(json.dumps(unique, ensure_ascii=False))


def report_failure(title, message):
    """Surface launch failures via zenity (notify-send fallback) instead of
    dying silently, where quickshell would swallow the stderr."""
    if shutil.which("zenity"):
        subprocess.Popen(["zenity", "--error", "--title=" + title, "--text=" + message],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    elif shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-u", "critical", "-a", "dwm-calendar",
                          title, message],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    else:
        print(message, file=sys.stderr)


def spawn_terminal(argv, failure_hint):
    """Spawn a terminal command; a fast nonzero exit is reported visibly."""
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception as exc:
        report_failure("Calendar", failure_hint + "\n\n" + str(exc))
        return
    # Healthy terminals keep running; anything that dies within a moment
    # failed before drawing a window (unknown command, bad display, ...).
    time.sleep(0.3)
    status = proc.poll()
    if status is None or status == 0:
        return
    if status == 127:
        report_failure("Calendar", failure_hint +
                       "\n\nNo supported terminal emulator was found. Install one of: "
                       "dwmterm, alacritty, st, warp-terminal, xterm, or set DWM_TERMINAL.")
    else:
        report_failure("Calendar", failure_hint +
                       "\n\nThe terminal exited with status " + str(status) + ".")


def launch_interactive():
    helper = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dwm-terminal")
    if os.path.exists(helper) and os.access(helper, os.X_OK):
        # dwm-terminal forwards arguments verbatim to the chosen terminal, and
        # terminals like alacritty reject bare commands — callers must pass
        # the command through -e, or alacritty exits with an argument error.
        spawn_terminal([helper, "-e", "khal", "interactive"],
                       "Could not open khal interactive.")
        return
    for candidate in ("alacritty", "st", "xterm"):
        if shutil.which(candidate):
            spawn_terminal([candidate, "-e", "khal", "interactive"],
                           "Could not open khal interactive in " + candidate + ".")
            return
    report_failure("Calendar", "Could not open khal interactive: no terminal emulator found.")


def main():
    if len(sys.argv) < 2:
        fetch_events()
        return

    action = sys.argv[1]
    if action == "events":
        m = sys.argv[2] if len(sys.argv) > 2 else None
        y = sys.argv[3] if len(sys.argv) > 3 else None
        fetch_events(m, y)
    elif action == "interactive":
        launch_interactive()
    else:
        fetch_events()


if "__main__" == __name__:
    main()
